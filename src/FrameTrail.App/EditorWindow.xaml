<Window x:Class="FrameTrail.App.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FrameTrail.App">
 <Grid x:Name="Root" Background="{ThemeResource EditorStage}" KeyDown="Root_KeyDown" PreviewKeyDown="Root_PreviewKeyDown" RequestedTheme="Light">
  <Grid.Resources>
   <SolidColorBrush x:Key="SliderThumbBackground" Color="#F7F7F7"/><SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White"/><SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#EAEAEA"/>
   <StaticResource x:Key="SliderTrackValueFill" ResourceKey="EditorInk"/><StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="EditorInk"/><StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="EditorInk"/>
   <Style TargetType="TextBlock" BasedOn="{StaticResource EditorText}"/><Style TargetType="Button" BasedOn="{StaticResource EditorButton}"/><Style TargetType="NumberBox" BasedOn="{StaticResource EditorInput}"/><Style TargetType="ComboBox" BasedOn="{StaticResource EditorCombo}"/>
   <Style TargetType="CheckBox" BasedOn="{StaticResource EditorSwitch}"><Setter Property="FontFamily" Value="{StaticResource RecorderFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="30"/></Style>
   <Style x:Key="SmallLabel" TargetType="TextBlock" BasedOn="{StaticResource EditorCaption}"/>
   <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource EditorCaption}"><Setter Property="FontFamily" Value="{StaticResource RecorderSemiboldFont}"/><Setter Property="Margin" Value="4,0,0,6"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition x:Name="TimelineRow" Height="214"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBand" Background="{ThemeResource EditorPanel}" BorderBrush="{ThemeResource EditorLine}" BorderThickness="0,0,0,1" Padding="12,0,144,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
    <Button x:Name="ProjectMenuButton" Width="38" Padding="0" AutomationProperties.Name="项目" ToolTipService.ToolTip="项目"><StackPanel Orientation="Horizontal" Spacing="4"><local:EditorGlyph Kind="Folder" Width="15" Height="15"/><local:EditorGlyph Kind="Chevron" Width="9" Height="9"/></StackPanel><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="SwitchProjectMenuItem" Text="切换项目…" Click="OpenProject_Click" AutomationProperties.AutomationId="editor.openProject"/><MenuFlyoutItem Text="场景预设…" Click="ManagePresets_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="查看工程素材" Click="Sources_Click"/><MenuFlyoutItem Text="导出工程副本…" Click="Export_Click"/></MenuFlyout></Button.Flyout></Button>
    <TextBlock x:Name="ProjectTitle" FontFamily="{StaticResource RecorderSemiboldFont}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <Border Background="{ThemeResource EditorWell}" CornerRadius="15" Padding="10,5"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Check" Foreground="#008F68" Width="12" Height="12"/><TextBlock x:Name="SaveStatus" Text="已保存" FontSize="11" Foreground="{ThemeResource EditorSecondary}"/></StackPanel></Border>
    <Button x:Name="RetrySave" Content="重试" Visibility="Collapsed" Click="RetrySave_Click"/>
    <Border Width="1" Height="16" Background="{ThemeResource EditorLine}" Margin="8,0"/>
    <Button x:Name="UndoButton" Style="{StaticResource EditorIconButton}" Click="Undo_Click" AutomationProperties.Name="撤销" ToolTipService.ToolTip="撤销 · Ctrl+Z"><local:EditorGlyph Kind="Undo"/></Button><Button x:Name="RedoButton" Style="{StaticResource EditorIconButton}" Click="Redo_Click" AutomationProperties.Name="重做" ToolTipService.ToolTip="重做 · Ctrl+Y"><local:EditorGlyph Kind="Redo"/></Button>
   </StackPanel>
   <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent" MinWidth="12"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
    <Button x:Name="ScenePresetButton" Click="ScenePreset_Click" ToolTipService.ToolTip="应用或保存场景预设"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Layers" Width="14" Height="14"/><TextBlock Text="场景预设" FontSize="11"/><local:EditorGlyph Kind="Chevron" Width="8" Height="8"/></StackPanel></Button>
    <Button Style="{StaticResource EditorIconButton}" Click="Appearance_Click" AutomationProperties.Name="切换明暗外观" ToolTipService.ToolTip="切换明暗外观"><local:EditorGlyph Kind="Sun"/></Button><Button Style="{StaticResource EditorIconButton}" Click="Settings_Click" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><local:EditorGlyph Kind="Settings"/></Button>
    <Border Width="1" Height="16" Background="{ThemeResource EditorLine}" Margin="6,0"/>
    <Button x:Name="DeleteProjectButton" Click="DeleteProject_Click" Foreground="#E35D62" AutomationProperties.Name="删除当前项目" AutomationProperties.AutomationId="editor.deleteProject" ToolTipService.ToolTip="删除当前项目"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Trash" Width="14" Height="14" Foreground="#E35D62"/><TextBlock Text="删除项目" Foreground="#E35D62" FontSize="12"/></StackPanel></Button>
    <Button x:Name="ExportButton" Style="{StaticResource EditorPrimaryButton}" Click="Export_Click" AutomationProperties.Name="导出"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Share" Foreground="{StaticResource EditorBlueInk}" Width="14" Height="14"/><TextBlock x:Name="ExportLabel" Text="导出" Foreground="{StaticResource EditorBlueInk}" FontFamily="{StaticResource RecorderSemiboldFont}"/></StackPanel></Button>
   </StackPanel>
  </Grid>
  <Grid x:Name="EditorBody" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
   <Grid x:Name="PreviewStage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions><local:EditorStageDots Grid.RowSpan="2"/>
    <Grid x:Name="PreviewContainer" Margin="16,16,16,0" SizeChanged="PreviewContainer_SizeChanged" DoubleTapped="Preview_DoubleTapped"><ScrollViewer x:Name="CanvasScroll" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" CornerRadius="10"><Grid x:Name="PreviewMount" Background="#070708"/></ScrollViewer></Grid>
    <Border x:Name="PreviewTransport" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource EditorPanel}" BorderBrush="{ThemeResource EditorLine}" BorderThickness="0.5" CornerRadius="22" Padding="4" Height="44" Translation="0,0,16"><Border.Shadow><ThemeShadow/></Border.Shadow><StackPanel Orientation="Horizontal" Spacing="2">
     <StackPanel x:Name="PreviewEditTools" Orientation="Horizontal" Spacing="2">
      <Button Click="RatioHud_Click" ToolTipService.ToolTip="画面比例"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Aspect" Width="13" Height="13"/><TextBlock x:Name="RatioHudLabel" Text="16:9" FontSize="11" Foreground="{ThemeResource EditorSecondary}"/><local:EditorGlyph Kind="Chevron" Width="8" Height="8"/></StackPanel></Button>
      <Button Click="CropHud_Click" ToolTipService.ToolTip="裁切主画面"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Crop" Width="14" Height="14"/><TextBlock Text="裁切" FontSize="11" Foreground="{ThemeResource EditorSecondary}"/></StackPanel></Button>
      <Button Style="{StaticResource EditorIconButton}" Click="PreviewOptions_Click" AutomationProperties.Name="预览选项" AutomationProperties.AutomationId="editor.preview.options" ToolTipService.ToolTip="预览选项"><local:EditorGlyph Kind="Sliders"/></Button><Border Width="1" Height="16" Background="{ThemeResource EditorLine}" Margin="6,0"/>
     </StackPanel>
     <Button Style="{StaticResource EditorIconButton}" Click="PreviousFrame_Click" ToolTipService.ToolTip="上一帧 · ←" AutomationProperties.Name="上一帧"><local:EditorGlyph Kind="Previous" Width="15" Height="15"/></Button>
     <Button x:Name="PlayButton" Background="{StaticResource EditorBlue}" Foreground="{StaticResource EditorBlueInk}" Width="36" Height="36" CornerRadius="18" Padding="0" Click="Play_Click" ToolTipService.ToolTip="播放 / 暂停 · Space" AutomationProperties.Name="播放或暂停"><local:EditorGlyph x:Name="PlayGlyph" Kind="Play" Foreground="{StaticResource EditorBlueInk}" Width="15" Height="15"/></Button>
     <Button Style="{StaticResource EditorIconButton}" Click="NextFrame_Click" ToolTipService.ToolTip="下一帧 · →" AutomationProperties.Name="下一帧"><local:EditorGlyph Kind="Next" Width="15" Height="15"/></Button><TextBlock x:Name="AudioPreparationLabel" FontSize="10" Foreground="{ThemeResource EditorSecondary}" VerticalAlignment="Center"/><TextBlock x:Name="ClockLabel" Text="00:00.00 / 00:00.00" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Margin="6,0,10,0"/>
     <Button x:Name="FullscreenButton" Style="{StaticResource EditorIconButton}" Click="Fullscreen_Click" AutomationProperties.Name="全屏预览" AutomationProperties.AutomationId="editor.preview.fullscreen"><ToolTipService.ToolTip><ToolTip x:Name="FullscreenTip" Content="全屏预览 · F11 / 双击视频"/></ToolTipService.ToolTip><local:EditorGlyph x:Name="FullscreenGlyph" Kind="Fullscreen" Width="15" Height="15"/></Button>
    </StackPanel></Border>
    <ComboBox x:Name="CanvasZoom" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="CanvasZoom_SelectionChanged"><ComboBoxItem Content="适合窗口"/><ComboBoxItem Content="125%"/><ComboBoxItem Content="150%"/><ComboBoxItem Content="200%"/></ComboBox>
   </Grid><Border Grid.Column="1" Background="{ThemeResource EditorLine}"/>
   <Grid Grid.Column="2" Background="{ThemeResource EditorPanel}"><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="InspectorTabs" Orientation="Horizontal" Spacing="2" Margin="8,4" HorizontalAlignment="Center"/>
    <Grid Grid.Row="1" Margin="18,0,18,14" VerticalAlignment="Bottom"><TextBlock x:Name="InspectorHeading" Text="画面" FontSize="34" FontFamily="{StaticResource RecorderSemiboldFont}"/><Border Background="{ThemeResource EditorWell}" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5" Padding="10,4"><TextBlock x:Name="InspectorScope" Text="全片" Foreground="{ThemeResource EditorSecondary}" FontSize="11"/></Border></Grid>
    <Border x:Name="FrameNavigation" Grid.Row="2" Background="{ThemeResource EditorWell}" CornerRadius="18" Margin="14,0,14,14" Padding="2"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="BackgroundTab" Background="{StaticResource EditorBlue}" Foreground="{StaticResource EditorBlueInk}" Height="32" HorizontalAlignment="Stretch" Click="BackgroundTab_Click"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Layers" Width="14" Height="14"/><TextBlock Text="背景" FontSize="12"/></StackPanel></Button>
     <Button x:Name="LayoutTab" Grid.Column="1" Height="32" HorizontalAlignment="Stretch" Click="LayoutTab_Click"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Layout" Width="14" Height="14"/><TextBlock Text="布局" FontSize="12"/></StackPanel></Button>
     <Button x:Name="MockupTab" Grid.Column="2" Height="32" HorizontalAlignment="Stretch" Click="FrameMockup_Click" ToolTipService.ToolTip="窗口、浏览器与设备边框"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Film" Width="14" Height="14"/><TextBlock Text="样机" FontSize="12"/></StackPanel></Button>
    </Grid></Border>
    <ScrollViewer x:Name="InspectorScroll" Grid.Row="3" VerticalScrollBarVisibility="Hidden" Padding="14,0,14,20"><StackPanel Spacing="16">
     <StackPanel x:Name="PictureSettings" Spacing="16">
      <StackPanel x:Name="BackgroundSettings" Spacing="16">
       <Border Style="{StaticResource EditorTile}" Height="148" Padding="30,20"><Grid><local:EditorStageDots/><Image x:Name="BackgroundPreview" Stretch="Uniform" MaxHeight="106"/></Grid></Border>
       <StackPanel><TextBlock Text="背景素材" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="12">
        <Border Background="{ThemeResource EditorPanel}" CornerRadius="18" Padding="2">
         <Grid x:Name="BackgroundSourceTabs"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Content="壁纸" Tag="image" Click="Backdrop_Click" Style="{StaticResource EditorSegmentButton}" ToolTipService.ToolTip="导入背景图片"/>
          <Button Grid.Column="1" Content="渐变" Tag="gradient" Click="Backdrop_Click" Style="{StaticResource EditorSegmentButton}"/>
          <Button Grid.Column="2" Content="动效" Tag="video" Click="Backdrop_Click" Style="{StaticResource EditorSegmentButton}" ToolTipService.ToolTip="导入循环视频"/>
          <Button Grid.Column="3" Content="纯色" Tag="solid" Click="Backdrop_Click" Style="{StaticResource EditorSegmentButton}" Background="{StaticResource EditorBlue}" Foreground="{StaticResource EditorBlueInk}"/>
         </Grid>
        </Border>
        <Grid x:Name="BackgroundColors" ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <Button Tag="#14161B" Background="#14161B" Height="64" HorizontalAlignment="Stretch" CornerRadius="10" Click="Background_Click" AutomationProperties.Name="深灰背景"/><Button Tag="#E8E6DF" Grid.Column="1" Background="#E8E6DF" Height="64" HorizontalAlignment="Stretch" CornerRadius="10" Click="Background_Click" AutomationProperties.Name="暖白背景"/><Button Tag="#55786C" Grid.Column="2" Background="#55786C" Height="64" HorizontalAlignment="Stretch" CornerRadius="10" Click="Background_Click" AutomationProperties.Name="绿色背景"/>
         <Button Tag="#56678C" Grid.Row="1" Background="#56678C" Height="64" HorizontalAlignment="Stretch" CornerRadius="10" Click="Background_Click" AutomationProperties.Name="蓝色背景"/><Button Tag="#96796E" Grid.Row="1" Grid.Column="1" Background="#96796E" Height="64" HorizontalAlignment="Stretch" CornerRadius="10" Click="Background_Click" AutomationProperties.Name="棕色背景"/><Button Tag="#ECEDEF" Grid.Row="1" Grid.Column="2" Background="#ECEDEF" Height="64" HorizontalAlignment="Stretch" CornerRadius="10" Click="Background_Click" AutomationProperties.Name="银灰背景"/>
        </Grid>
       </StackPanel></Border></StackPanel>
      </StackPanel>
      <StackPanel x:Name="LayoutSettings" Visibility="Collapsed" Spacing="16">
       <StackPanel><TextBlock Text="画布比例" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="10"><ComboBox x:Name="AspectRatio" SelectedIndex="0" SelectionChanged="PictureChoice_Changed" AutomationProperties.Name="画布比例"><ComboBoxItem Content="原始比例"/><ComboBoxItem Content="16:9"/><ComboBoxItem Content="9:16"/><ComboBoxItem Content="1:1"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="自定义尺寸"/></ComboBox><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><NumberBox x:Name="CanvasWidth" Header="宽度" Minimum="2" Maximum="7680" LostFocus="PictureInput_LostFocus"/><NumberBox x:Name="CanvasHeight" Grid.Column="1" Header="高度" Minimum="2" Maximum="7680" LostFocus="PictureInput_LostFocus"/></Grid></StackPanel></Border></StackPanel>
       <StackPanel><TextBlock Text="画面与外观" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="8"><TextBlock Text="留白" Foreground="{ThemeResource EditorSecondary}"/><local:EditorBarSlider x:Name="PaddingValue" Minimum="0" Maximum="30" StepFrequency="1" Suffix="%" Committed="PictureBar_Committed" AutomationProperties.Name="画面留白"/><TextBlock Text="圆角" Foreground="{ThemeResource EditorSecondary}"/><local:EditorBarSlider x:Name="CornerValue" Minimum="0" Maximum="200" StepFrequency="2" Committed="PictureBar_Committed" AutomationProperties.Name="画面圆角"/><TextBlock Text="阴影" Foreground="{ThemeResource EditorSecondary}"/><local:EditorBarSlider x:Name="ShadowValue" Minimum="0" Maximum="1" StepFrequency="0.05" Committed="PictureBar_Committed" AutomationProperties.Name="画面阴影"/></StackPanel></Border></StackPanel>
       <StackPanel><TextBlock Text="裁切" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="8"><CheckBox x:Name="CropEnabled" Content="裁切主画面" Click="PictureToggle_Click"/><Grid ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><NumberBox x:Name="CropX" Header="X (%)" Minimum="0" Maximum="99" LostFocus="PictureInput_LostFocus"/><NumberBox x:Name="CropY" Grid.Column="1" Header="Y (%)" Minimum="0" Maximum="99" LostFocus="PictureInput_LostFocus"/><NumberBox x:Name="CropWidth" Grid.Row="1" Header="宽 (%)" Minimum="1" Maximum="100" LostFocus="PictureInput_LostFocus"/><NumberBox x:Name="CropHeight" Grid.Row="1" Grid.Column="1" Header="高 (%)" Minimum="1" Maximum="100" LostFocus="PictureInput_LostFocus"/></Grid></StackPanel></Border></StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"><Button Content="复制画面" Click="CopyPicture_Click"/><Button Content="粘贴画面" Click="PastePicture_Click"/></StackPanel>
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="CursorSettings" Visibility="Collapsed" Spacing="16"><TextBlock Text="光标外观" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="8"><TextBlock Text="光标大小" Foreground="{ThemeResource EditorSecondary}"/><local:EditorBarSlider x:Name="CursorValue" Minimum="0" Maximum="4" StepFrequency="0.25" Suffix="×" Committed="PictureBar_Committed" AutomationProperties.Name="光标大小"/><TextBlock Text="设为 0 可隐藏光标。" Style="{StaticResource SmallLabel}"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="CameraSettings" Visibility="Collapsed" Spacing="16"><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="8"><CheckBox x:Name="CameraVisible" Content="显示摄像头" Click="PictureToggle_Click"/><CheckBox x:Name="CameraMirror" Content="镜像" Click="PictureToggle_Click"/></StackPanel></Border><StackPanel><TextBlock Text="基础布局" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="8"><TextBlock Text="大小" Foreground="{ThemeResource EditorSecondary}"/><local:EditorBarSlider x:Name="CameraSize" Minimum="5" Maximum="60" StepFrequency="1" Suffix="%" Committed="PictureBar_Committed" AutomationProperties.Name="摄像头大小"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><NumberBox x:Name="CameraX" Header="X (%)" Minimum="0" Maximum="95" LostFocus="PictureInput_LostFocus"/><NumberBox x:Name="CameraY" Grid.Column="1" Header="Y (%)" Minimum="0" Maximum="95" LostFocus="PictureInput_LostFocus"/></Grid></StackPanel></Border></StackPanel></StackPanel>
     <StackPanel x:Name="AudioSettings" Visibility="Collapsed" Spacing="16">
      <StackPanel><TextBlock Text="全片混音" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="8"><TextBlock x:Name="PrimaryAudioLabel" Text="系统声音" Foreground="{ThemeResource EditorSecondary}"/><local:EditorBarSlider x:Name="SystemGain" Minimum="0" Maximum="200" StepFrequency="5" Suffix="%" Committed="AudioBar_Committed" AutomationProperties.Name="系统声音音量"/><CheckBox x:Name="SystemMute" Content="静音" Click="AudioToggle_Click"/><TextBlock Text="麦克风" Foreground="{ThemeResource EditorSecondary}"/><local:EditorBarSlider x:Name="MicGain" Minimum="0" Maximum="200" StepFrequency="5" Suffix="%" Committed="AudioBar_Committed" AutomationProperties.Name="麦克风音量"/><CheckBox x:Name="MicMute" Content="静音" Click="AudioToggle_Click"/></StackPanel></Border></StackPanel>
      <StackPanel><TextBlock Text="选中片段" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="8"><TextBlock x:Name="ClipPrimaryAudioLabel" Text="系统声音" Foreground="{ThemeResource EditorSecondary}"/><local:EditorBarSlider x:Name="ClipSystemGain" Minimum="0" Maximum="200" StepFrequency="5" Suffix="%" Committed="AudioBar_Committed" AutomationProperties.Name="片段系统声音音量"/><CheckBox x:Name="ClipSystemMute" Content="静音片段系统音" Click="AudioToggle_Click"/><TextBlock Text="麦克风" Foreground="{ThemeResource EditorSecondary}"/><local:EditorBarSlider x:Name="ClipMicGain" Minimum="0" Maximum="200" StepFrequency="5" Suffix="%" Committed="AudioBar_Committed" AutomationProperties.Name="片段麦克风音量"/><CheckBox x:Name="ClipMicMute" Content="静音片段麦克风" Click="AudioToggle_Click"/></StackPanel></Border></StackPanel>
     </StackPanel>
     <StackPanel x:Name="ClipSettings" Visibility="Collapsed" Spacing="16"><TextBlock x:Name="ClipLabel" Text="选择一个片段" Style="{StaticResource SectionLabel}"/><Border Style="{StaticResource EditorTile}"><StackPanel Spacing="10"><ComboBox x:Name="RateValue" Header="速度 · 保持音调" SelectedIndex="2" SelectionChanged="RateChoice_Changed"><ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="1.5×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/></ComboBox><NumberBox x:Name="TrimStart" Header="源入点 (秒)" Minimum="0" SmallChange="0.1"/><NumberBox x:Name="TrimEnd" Header="源出点 (秒)" Minimum="0" SmallChange="0.1"/><Button Content="裁剪片段" Click="ApplyTrim_Click" HorizontalAlignment="Stretch" Background="{ThemeResource EditorPanel}"/><StackPanel Orientation="Horizontal" Spacing="6"><Button Content="前移片段" Click="MoveEarlier_Click"/><Button Content="后移片段" Click="MoveLater_Click"/></StackPanel></StackPanel></Border><Button Content="恢复原始顺序与时长" Click="Restore_Click"/></StackPanel>
     <Border x:Name="UnavailableSettings" Visibility="Collapsed" Style="{StaticResource EditorTile}"><StackPanel Spacing="12" Margin="0,12"><local:EditorGlyph x:Name="UnavailableGlyph" Kind="Opening" Width="32" Height="32" Foreground="{ThemeResource EditorTertiary}"/><TextBlock x:Name="UnavailableTitle" Text="开场效果暂未开放" HorizontalAlignment="Center"/><TextBlock Text="你可以继续剪辑画面、调整声音并导出作品。" Foreground="{ThemeResource EditorSecondary}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"/></StackPanel></Border>
     <ComboBox x:Name="InspectorMode" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="InspectorMode_SelectionChanged"><ComboBoxItem Content="画面"/><ComboBoxItem Content="声音"/><ComboBoxItem Content="片段"/></ComboBox>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True"/>
  <Grid x:Name="TimelinePanel" Grid.Row="3" Background="{ThemeResource EditorPanel}" BorderBrush="{ThemeResource EditorLine}" BorderThickness="0,1,0,0"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Padding="12,0" BorderBrush="{ThemeResource EditorLine}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"><Button Style="{StaticResource EditorIconButton}" Click="Split_Click" AutomationProperties.Name="分割" ToolTipService.ToolTip="在播放头处分割 · S"><local:EditorGlyph Kind="Scissors"/></Button><Button Style="{StaticResource EditorIconButton}" Click="Delete_Click" AutomationProperties.Name="删除片段" ToolTipService.ToolTip="删除片段 · Delete"><local:EditorGlyph Kind="Trash"/></Button><Button Style="{StaticResource EditorIconButton}" Click="Restore_Click" AutomationProperties.Name="恢复原始剪辑" ToolTipService.ToolTip="恢复原始顺序与时长"><local:EditorGlyph Kind="Undo"/></Button><Button Click="ClipTab_Click" ToolTipService.ToolTip="片段速度与入出点"><local:EditorGlyph Kind="Next" Width="13" Height="13"/></Button></StackPanel>
    <Border Grid.Column="1" Background="{ThemeResource EditorWell}" CornerRadius="12" Padding="3" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="2"><Button x:Name="FilmModeButton" CornerRadius="9" Height="28" Background="{ThemeResource EditorThumb}" Click="FilmMode_Click"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Film" Width="14" Height="14"/><TextBlock Text="画面" FontSize="11"/></StackPanel></Button><Button x:Name="WaveModeButton" CornerRadius="9" Height="28" Click="WaveMode_Click"><StackPanel Orientation="Horizontal" Spacing="6"><local:EditorGlyph Kind="Waveform" Width="14" Height="14"/><TextBlock Text="波形" FontSize="11" Foreground="{ThemeResource EditorSecondary}"/></StackPanel></Button></StackPanel></Border>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SnapButton" Background="#205AAEFF" Click="Snap_Click" ToolTipService.ToolTip="时间线吸附"><StackPanel Orientation="Horizontal" Spacing="5"><local:EditorGlyph Kind="Magnet" Width="13" Height="13"/><TextBlock x:Name="SnapLabel" Text="吸附" FontSize="11"/></StackPanel></Button><Button Click="FitTimeline_Click" ToolTipService.ToolTip="显示完整时间线"><local:EditorGlyph Kind="Fit" Width="14" Height="14"/></Button><Button Style="{StaticResource EditorIconButton}" Click="ZoomOut_Click" AutomationProperties.Name="缩小时间线"><local:EditorGlyph Kind="Minus" Width="13" Height="13"/></Button><Slider x:Name="TimelineZoom" Width="100" Minimum="0.05" Maximum="1000" Foreground="{ThemeResource EditorInk}" Value="80" ValueChanged="TimelineZoom_ValueChanged" AutomationProperties.Name="时间线缩放"/><Button Style="{StaticResource EditorIconButton}" Click="ZoomIn_Click" AutomationProperties.Name="放大时间线"><local:EditorGlyph Kind="Plus" Width="13" Height="13"/></Button></StackPanel><TextBlock x:Name="TimelineSummary" Visibility="Collapsed"/>
   </Grid>
