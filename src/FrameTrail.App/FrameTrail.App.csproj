<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NativeBuildDirectory Condition="'$(NativeBuildDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\native</NativeBuildDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\Fonts\*.otf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <ProjectReference Include="..\FrameTrail.Interop\FrameTrail.Interop.csproj" />
    <ProjectReference Include="..\FrameTrail.Workspace\FrameTrail.Workspace.csproj" />
  </ItemGroup>
  <Target Name="CopyNativeEngine" AfterTargets="Build">
    <ItemGroup>
      <NativeEngineDll Include="$(NativeBuildDirectory)\bin\$(Configuration)\FrameTrail.*.dll" />
      <NativeEngineDll Include="$(NativeBuildDirectory)\bin\FrameTrail.*.dll" />
    </ItemGroup>
    <Error Condition="!Exists('$(NativeBuildDirectory)\bin\$(Configuration)\FrameTrail.Engine.dll') And !Exists('$(NativeBuildDirectory)\bin\FrameTrail.Engine.dll')" Text="Build the native engine first using scripts/build.ps1." />
    <Copy SourceFiles="@(NativeEngineDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
