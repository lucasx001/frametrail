<Window x:Class="FrameTrail.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:FrameTrail.App" Title="FrameTrail">
 <Grid x:Name="RecorderRoot" Background="{ThemeResource RecorderBase}" CornerRadius="28" BorderBrush="{ThemeResource RecorderEdge}" BorderThickness="1" KeyDown="Root_KeyDown">
  <Grid.Resources>
   <Flyout x:Name="MicrophoneFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource RecorderFlyout}">
    <StackPanel Width="268" Spacing="4">
     <ToggleButton x:Name="MicEnabled" Content="麦克风" Style="{StaticResource RecorderInputToggle}" Checked="Input_Changed" Unchecked="Input_Changed" AutomationProperties.Name="录制麦克风" />
     <StackPanel x:Name="MicrophoneDevices" /><TextBlock x:Name="MicrophoneEmpty" Text="未发现麦克风" Style="{StaticResource RecorderCaption}" Margin="10,8" />
     <StackPanel x:Name="MicrophoneMeterPanel" Visibility="Collapsed" Margin="10,12,10,8" Spacing="8">
      <ProgressBar x:Name="MicrophoneLevel" Minimum="0" Maximum="1" Height="3" Foreground="{StaticResource RecorderMint}" Background="{ThemeResource RecorderWell}" AutomationProperties.Name="麦克风实时电平" />
      <TextBlock Text="录制时显示输入电平" Style="{StaticResource RecorderCaption}" />
     </StackPanel>
    </StackPanel>
   </Flyout>
   <Flyout x:Name="CameraFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource RecorderFlyout}">
    <StackPanel Width="268" Spacing="4">
     <ToggleButton x:Name="CameraEnabled" Content="摄像头" Style="{StaticResource RecorderInputToggle}" Checked="Input_Changed" Unchecked="Input_Changed" AutomationProperties.Name="录制摄像头" />
     <StackPanel x:Name="CameraDevices" /><TextBlock x:Name="CameraEmpty" Text="未发现摄像头" Style="{StaticResource RecorderCaption}" Margin="10,8" />
     <StackPanel x:Name="CameraOptions" Margin="10,8" Spacing="8" Visibility="Collapsed">
      <ComboBox x:Name="CameraFormatPicker" HorizontalAlignment="Stretch" FontSize="12" Background="{ThemeResource RecorderWell}" BorderThickness="0" CornerRadius="10" AutomationProperties.Name="摄像头采集格式" />
      <TextBlock Text="独立保存摄像头画面；实时预览将在后续版本提供。" Style="{StaticResource RecorderCaption}" />
     </StackPanel>
    </StackPanel>
   </Flyout>
   <Flyout x:Name="SystemFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource RecorderFlyout}">
    <StackPanel Width="268" Spacing="4">
     <ToggleButton x:Name="SystemEnabled" Content="系统声音" Style="{StaticResource RecorderInputToggle}" Checked="Input_Changed" Unchecked="Input_Changed" AutomationProperties.Name="录制系统声音" />
     <RadioButton x:Name="AllSystemAudio" Content="全部系统声音" GroupName="AudioScope" Style="{StaticResource RecorderChoice}" IsChecked="True" Checked="AudioScope_Changed" />
     <RadioButton x:Name="ProcessAudio" Content="所选窗口 App" GroupName="AudioScope" Style="{StaticResource RecorderChoice}" Checked="AudioScope_Changed" />
     <TextBlock x:Name="ProcessAudioHint" Text="选择窗口后可录制该 App 的进程树声音" Style="{StaticResource RecorderCaption}" Margin="35,0,10,6" />
     <Border Height="1" Background="{ThemeResource RecorderLine}" Margin="10,6" />
     <StackPanel x:Name="SystemDevices" /><TextBlock x:Name="SystemEmpty" Text="未发现声音输出设备" Style="{StaticResource RecorderCaption}" Margin="10,8" />
    </StackPanel>
   </Flyout>
   <Flyout x:Name="MoreFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource RecorderFlyout}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="620">
     <StackPanel Width="278" Spacing="4">
      <Button x:Name="DestinationButton" Style="{StaticResource RecorderMenuButton}" Click="Destination_Click" AutomationProperties.Name="选择保存文件夹">
       <Grid Width="250" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
        <local:RecorderGlyph Kind="Folder" Width="16" Height="16" /><TextBlock x:Name="DestinationName" Grid.Column="1" Text="FrameTrail" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="›" Foreground="{ThemeResource RecorderFaint}" />
       </Grid>
      </Button>
      <TextBox x:Name="RecordingName" PlaceholderText="自动命名" Margin="6,4" Height="34" MinHeight="34" FontFamily="{StaticResource RecorderFont}" FontSize="13" Padding="12,5" Background="{ThemeResource RecorderWell}" BorderThickness="0" CornerRadius="17" AutomationProperties.Name="录制名称" />
      <StackPanel Margin="10,4" Spacing="6"><TextBlock Text="视频编码" Style="{StaticResource RecorderCaption}"/><ComboBox x:Name="CodecPicker" HorizontalAlignment="Stretch" FontSize="12" BorderThickness="0" Background="{ThemeResource RecorderWell}" CornerRadius="16" AutomationProperties.Name="录制视频编码" AutomationProperties.AutomationId="recorder.videoCodec"/></StackPanel>
      <Grid Margin="10,4" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
       <TextBlock Text="帧率上限" VerticalAlignment="Center" /><ComboBox x:Name="FpsPicker" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch" FontSize="12" BorderThickness="0" Background="{ThemeResource RecorderWell}" CornerRadius="16" AutomationProperties.Name="录制帧率上限"><ComboBoxItem Content="30 FPS" /><ComboBoxItem Content="60 FPS" /></ComboBox>
      </Grid>
      <ToggleButton x:Name="PointerEnabled" Content="记录光标与点击" IsChecked="True" Checked="AutomaticZoom_Changed" Unchecked="AutomaticZoom_Changed" Style="{StaticResource RecorderSettingToggle}" />
      <ToggleButton x:Name="ExcludeControl" Content="排除录制条与备忘录" IsChecked="True" Checked="Exclusion_Changed" Unchecked="Exclusion_Changed" Style="{StaticResource RecorderSettingToggle}" />
      <Border Height="1" Background="{ThemeResource RecorderLine}" Margin="10,6" />
      <Button Style="{StaticResource RecorderMenuButton}" Click="Android_Click" Content="Android USB 录屏…" />
      <Button Style="{StaticResource RecorderMenuButton}" Click="Open_Click" Content="打开已有项目…" />
      <Button x:Name="RecoverButton" Style="{StaticResource RecorderMenuButton}" Click="Recovery_Click" Content="恢复中断录制" />
      <Button x:Name="MemoMenuButton" Style="{StaticResource RecorderMenuButton}" Click="Memo_Click" Content="打开备忘录" />
      <Button x:Name="RefreshButton" Style="{StaticResource RecorderMenuButton}" Click="Refresh_Click" Content="刷新来源与设备" />
      <Button Style="{StaticResource RecorderMenuButton}" Click="Settings_Click" Content="设置…" />
      <Expander Header="更多设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" FontSize="13">
       <Expander.Resources>
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" /><SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#14808080" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" /><SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" /><SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
       </Expander.Resources>
       <StackPanel Width="232" Spacing="10">
        <CheckBox x:Name="SoftwareAllowed" Content="允许软件编码（最高 1080p30）" FontSize="12" />
        <TextBlock Text="停止录制快捷键" Style="{StaticResource RecorderCaption}" />
        <ComboBox x:Name="StopKey" SelectedIndex="3" HorizontalAlignment="Stretch" FontSize="12"><ComboBoxItem Content="Ctrl + Shift + F6" /><ComboBoxItem Content="Ctrl + Shift + F7" /><ComboBoxItem Content="Ctrl + Shift + F8" /><ComboBoxItem Content="Ctrl + Shift + F9" /><ComboBoxItem Content="Ctrl + Shift + F10" /><ComboBoxItem Content="Ctrl + Shift + F11" /><ComboBoxItem Content="Ctrl + Shift + F12" /></ComboBox>
        <TextBlock Text="添加标记快捷键" Style="{StaticResource RecorderCaption}" />
        <ComboBox x:Name="MarkerKey" SelectedIndex="4" HorizontalAlignment="Stretch" FontSize="12"><ComboBoxItem Content="Ctrl + Shift + F6" /><ComboBoxItem Content="Ctrl + Shift + F7" /><ComboBoxItem Content="Ctrl + Shift + F8" /><ComboBoxItem Content="Ctrl + Shift + F9" /><ComboBoxItem Content="Ctrl + Shift + F10" /><ComboBoxItem Content="Ctrl + Shift + F11" /><ComboBoxItem Content="Ctrl + Shift + F12" /></ComboBox>
        <Button Content="应用快捷键" Click="Hotkey_Click" Style="{StaticResource RecorderMenuButton}" /><TextBlock x:Name="HotkeyStatus" Style="{StaticResource RecorderCaption}" />
       </StackPanel>
      </Expander>
      <Border Height="1" Background="{ThemeResource RecorderLine}" Margin="10,6" />
      <Button Style="{StaticResource RecorderMenuButton}" Click="Quit_Click" Content="退出 FrameTrail" />
     </StackPanel>
    </ScrollViewer>
   </Flyout>
   <Flyout x:Name="RecordingMoreFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource RecorderFlyout}">
    <StackPanel Width="268" Spacing="4">
     <TextBlock Text="录制操作" Style="{StaticResource RecorderCaption}" Margin="10,4,10,6" />
     <Button Content="打开备忘录" Click="Memo_Click" Style="{StaticResource RecorderMenuButton}" />
     <Button Content="查看录制来源" Click="ShowSource_Click" Style="{StaticResource RecorderMenuButton}" />
     <Border Height="1" Background="{ThemeResource RecorderLine}" Margin="10,6" />
     <TextBlock x:Name="RecordingShortcutHint" Text="Ctrl + Shift + F9 结束录制" Style="{StaticResource RecorderCaption}" Margin="10,4" />
     <TextBlock Text="每 60 秒保存一个可恢复分段" Style="{StaticResource RecorderCaption}" Margin="10,4" />
    </StackPanel>
   </Flyout>
   <Flyout x:Name="MarkerFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource RecorderFlyout}">
    <StackPanel Width="268" Spacing="10">
     <TextBlock Text="录制标记" FontFamily="{StaticResource RecorderSemiboldFont}" FontSize="15" Margin="10,4" />
     <TextBox x:Name="MarkerLabel" PlaceholderText="标记文字（可选）" FontSize="13" CornerRadius="12" AutomationProperties.Name="录制标记文字" />
     <Button Content="添加标记" Click="AddLabeledMarker_Click" Style="{StaticResource RecorderPillButton}" HorizontalAlignment="Stretch" />
    </StackPanel>
   </Flyout>
   <Flyout x:Name="FeedbackFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource RecorderFlyout}">
    <StackPanel Width="268" Spacing="10" Padding="8">
     <TextBlock x:Name="FeedbackTitle" Text="提示" FontFamily="{StaticResource RecorderSemiboldFont}" FontSize="15" />
     <TextBlock x:Name="Feedback" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Foreground="{ThemeResource RecorderMuted}" AutomationProperties.Name="工作区提示" />
    </StackPanel>
   </Flyout>
   <Flyout x:Name="RecoveryFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource RecorderFlyout}">
    <StackPanel Width="268" Spacing="10" Padding="8">
     <TextBlock Text="恢复中断录制" FontFamily="{StaticResource RecorderSemiboldFont}" FontSize="15" />
     <ComboBox x:Name="RecoveryPicker" DisplayMemberPath="Directory" HorizontalAlignment="Stretch" FontSize="12" AutomationProperties.Name="待恢复工程" />
     <TextBlock Text="仅恢复已经完成的分段，未完成素材保留在工程目录中。" Style="{StaticResource RecorderCaption}" />
     <Button Content="恢复工程" Click="Recover_Click" Style="{StaticResource RecorderPillButton}" HorizontalAlignment="Stretch" />
    </StackPanel>
   </Flyout>
  </Grid.Resources>
  <StackPanel x:Name="SetupPanel" Orientation="Horizontal" Padding="7,0" VerticalAlignment="Center" AutomationProperties.Name="录制准备">
   <Button x:Name="SourceWheel" Width="106" Height="40" CornerRadius="20" Background="{ThemeResource RecorderWell}" Style="{StaticResource RecorderIconButton}" Click="SourceMode_Click" PointerWheelChanged="SourceMode_Wheel" KeyDown="SourceMode_KeyDown" AutomationProperties.Name="录制来源：显示器" ToolTipService.ToolTip="点击、滚轮或方向键切换录制来源">
    <StackPanel Orientation="Horizontal" Spacing="8"><local:RecorderGlyph x:Name="SourceGlyph" Kind="Display" /><TextBlock x:Name="SourceModeLabel" Text="显示器" FontFamily="{StaticResource RecorderSemiboldFont}" FontSize="13" VerticalAlignment="Center" /><Canvas Width="6" Height="10" VerticalAlignment="Center"><Path Data="M1,3 L3,1 L5,3 M1,7 L3,9 L5,7" Stroke="{ThemeResource RecorderFaint}" StrokeThickness="1" StrokeLineJoin="Round" /></Canvas></StackPanel>
   </Button>
   <Button x:Name="OpenProjectButton" Style="{StaticResource RecorderIconButton}" Click="Open_Click" AutomationProperties.Name="打开已有项目" AutomationProperties.AutomationId="recorder.openProject" ToolTipService.ToolTip="从项目保存目录打开已有项目"><local:RecorderGlyph Kind="Folder" Width="17" Height="17" /></Button>
   <Button x:Name="MicrophoneButton" Margin="6,0,0,0" Style="{StaticResource RecorderIconButton}" Click="Microphone_Click" AutomationProperties.Name="麦克风：关闭" ToolTipService.ToolTip="麦克风"><local:RecorderGlyph x:Name="MicrophoneGlyph" Kind="Microphone" IsOn="False" Width="16" Height="16" /></Button>
   <Button x:Name="CameraButton" Style="{StaticResource RecorderIconButton}" Click="Camera_Click" AutomationProperties.Name="摄像头：关闭" ToolTipService.ToolTip="摄像头"><local:RecorderGlyph x:Name="CameraGlyph" Kind="Camera" IsOn="False" Width="16" Height="16" /></Button>
   <Button x:Name="SystemButton" Style="{StaticResource RecorderIconButton}" Click="System_Click" AutomationProperties.Name="系统声音：关闭" ToolTipService.ToolTip="系统声音"><local:RecorderGlyph x:Name="SystemGlyph" Kind="Speaker" IsOn="False" Width="16" Height="16" /></Button>
   <ToggleButton x:Name="AutomaticZoomEnabled" Style="{StaticResource RecorderIconToggle}" IsChecked="True" Checked="AutomaticZoom_Changed" Unchecked="AutomaticZoom_Changed" AutomationProperties.AutomationId="recorder.autoZoom" AutomationProperties.Name="点击自动缩放：开启" ToolTipService.ToolTip="点击自动缩放：开启"><local:RecorderGlyph x:Name="AutomaticZoomGlyph" Kind="AutoZoom" Width="17" Height="17" /></ToggleButton>
   <Button x:Name="MoreButton" Style="{StaticResource RecorderIconButton}" Click="More_Click" AutomationProperties.Name="保存与录制配置" ToolTipService.ToolTip="保存与录制配置"><Grid><local:RecorderGlyph Kind="More" Width="16" Height="16" /><Ellipse x:Name="NoticeBadge" Width="5" Height="5" Fill="{StaticResource RecorderAmber}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Visibility="Collapsed" /></Grid></Button>
   <Button x:Name="StartButton" Margin="4,0,0,0" Style="{StaticResource RecorderIconButton}" Click="Start_Click" AutomationProperties.Name="选择来源并开始录制" ToolTipService.ToolTip="开始录制"><Grid Width="36" Height="36"><Ellipse Fill="{StaticResource RecorderRed}" /><Ellipse Fill="White" Width="12" Height="12" /></Grid></Button>
   <Grid Width="22" Height="40" Background="Transparent" AutomationProperties.Name="拖动录制条" ToolTipService.ToolTip="按住胶囊空白处或此处拖动"><local:RecorderGlyph Kind="Grip" Width="12" Height="14" Opacity="0.35" /></Grid>
  </StackPanel>
  <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" Padding="15,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="录制控制">
   <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,12,0" VerticalAlignment="Center">
    <Ellipse x:Name="RecordingDot" Width="8" Height="8" Fill="{StaticResource RecorderRed}" />
    <TextBlock x:Name="DurationText" Text="00:00" FontFamily="Segoe UI Variable Display" FontSize="15" FontWeight="SemiBold" MinWidth="46" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" AutomationProperties.Name="录制时长" />
    <StackPanel x:Name="LevelBars" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Visibility="Collapsed"><Border x:Name="Level1" Width="2.5" Height="3" CornerRadius="1.25" Background="{StaticResource RecorderMint}" /><Border x:Name="Level2" Width="2.5" Height="3" CornerRadius="1.25" Background="{StaticResource RecorderMint}" /><Border x:Name="Level3" Width="2.5" Height="3" CornerRadius="1.25" Background="{StaticResource RecorderMint}" /><Border x:Name="Level4" Width="2.5" Height="3" CornerRadius="1.25" Background="{StaticResource RecorderMint}" /></StackPanel>
   </StackPanel>
   <Button x:Name="MarkerButton" Width="36" Height="36" Style="{StaticResource RecorderIconButton}" Click="Marker_Click" RightTapped="Marker_RightTapped" AutomationProperties.Name="添加录制标记" ToolTipService.ToolTip="添加标记；右键添加文字"><Grid><local:RecorderGlyph Kind="Marker" Width="13" Height="13" /><TextBlock x:Name="MarkerCount" Text="" FontSize="9" FontWeight="Bold" Margin="12,-8,-8,0" /></Grid></Button>
   <Button Width="36" Height="36" Style="{StaticResource RecorderIconButton}" Click="Memo_Click" AutomationProperties.Name="备忘录" ToolTipService.ToolTip="备忘录"><local:RecorderGlyph Kind="Memo" Width="14" Height="14" /></Button>
   <Button x:Name="PauseButton" Width="36" Height="36" Style="{StaticResource RecorderIconButton}" Click="Pause_Click" AutomationProperties.Name="暂停录制" ToolTipService.ToolTip="暂停录制"><local:RecorderGlyph x:Name="PauseGlyph" Kind="Pause" Width="13" Height="13" /></Button>
   <Button x:Name="RecordingMoreButton" Width="32" Height="36" Style="{StaticResource RecorderIconButton}" Click="RecordingMore_Click" AutomationProperties.Name="更多录制操作" ToolTipService.ToolTip="更多录制操作"><local:RecorderGlyph Kind="More" Width="15" Height="15" /></Button>
   <Button x:Name="StopButton" Width="36" Height="36" Margin="6,0,0,0" Style="{StaticResource RecorderIconButton}" Click="Stop_Click" AutomationProperties.Name="结束录制" ToolTipService.ToolTip="结束录制"><Grid Width="36" Height="36"><Ellipse Fill="{StaticResource RecorderRed}" /><Border Background="White" CornerRadius="2.5" Width="11" Height="11" /></Grid></Button>
   <Grid Width="22" Height="36" Background="Transparent" AutomationProperties.Name="拖动录制条" ToolTipService.ToolTip="按住胶囊空白处或此处拖动"><local:RecorderGlyph Kind="Grip" Width="12" Height="14" Opacity="0.35" /></Grid>
  </StackPanel>
  <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="正在处理录制">
   <ProgressRing x:Name="TransitionProgress" IsActive="False" Width="16" Height="16" Foreground="{ThemeResource RecorderInk}" /><TextBlock x:Name="RecordingStatus" Text="正在准备…" FontFamily="{StaticResource RecorderSemiboldFont}" FontSize="13" VerticalAlignment="Center" />
  </StackPanel>
 </Grid>
</Window>
